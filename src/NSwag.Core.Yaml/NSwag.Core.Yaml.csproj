<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
    <RootNamespace>NSwag</RootNamespace>
  </PropertyGroup>
  
  <!-- Local project references for development -->
  <ItemGroup Condition="'$(UseLocalNJsonSchemaProjects)' == 'true'">
    <ProjectReference Include="..\..\..\NJsonSchema\src\NJsonSchema.Yaml\NJsonSchema.Yaml.csproj" />
  </ItemGroup>
  <!-- NuGet package references for production -->
  <ItemGroup Condition="'$(UseLocalNJsonSchemaProjects)' != 'true'">
    <PackageReference Include="NJsonSchema.Yaml" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\NSwag.Core\NSwag.Core.csproj" />
  </ItemGroup>
</Project>